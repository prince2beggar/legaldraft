# ==============================================================================
# AIN-AI Platform Environment Configuration (.env.example)
# Grounded in SRS Section 2.6
# ==============================================================================

# Core Database & Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ain_ai
REDIS_URL=redis://localhost:6379/0

# S3 Compatible Object Storage (MinIO)
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=ain-ai-vault
OBJECT_STORE_KEY=minioadmin
OBJECT_STORE_SECRET=minioadmin

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_64_char_key_in_production
PHONE_BLOCKLIST_SALT=replace_with_a_secure_random_64_char_salt_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# SMS & OTP Provider (Mock in S0/S1)
OTP_PROVIDER=mock
SMS_PROVIDER_API_KEY=mock_key
SMS_PROVIDER_SENDER_ID=AIN-AI

# AI Gateway & LLM Providers (No training, no retention)
LLM_PROVIDER_PRIMARY=mock
LLM_PROVIDER_FALLBACK=mock
LLM_REDACTION=on
EMBEDDER_MODEL=multilingual-e5-base

# Localization & Timezone
DEFAULT_LOCALE=bn
TIMEZONE=Asia/Dhaka
DATA_REGION=BD

# Rate Limits (Requests per minute / day)
RATE_LIMIT_OTP_REQUESTS=5
RATE_LIMIT_AI_CALLS_PER_USER_DAY=50
RATE_LIMIT_UPLOADS_PER_USER_DAY=20

# Data Retention Policy (Days)
RETENTION_DAYS_SOFT_DELETE=30
RETENTION_DAYS_SESSION_LOGS=90
RETENTION_DAYS_AUDIT_METADATA=1825
